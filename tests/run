#!/bin/sh
# Every test of the plugin. Nothing here connects anywhere or touches the
# real config or state; see helper.py.
cd -- "$(dirname -- "$0")" || exit 1
status=0
python3 -B -m unittest discover -s . -p 'test_*.py' "$@" || status=1
if command -v node >/dev/null 2>&1; then
  node run.js || status=1
else
  echo "node not found: run.js was not run" >&2
  status=1
fi
exit $status
